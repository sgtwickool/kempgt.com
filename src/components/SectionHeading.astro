---
import Overprint from "./Overprint.astro";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<Overprint
  as="h2"
  class="m-0 font-sans text-[clamp(2.4rem,6.2vw,4rem)] leading-[0.95] font-black tracking-[-0.03em] [font-stretch:125%] [text-wrap:balance]"
>
  {text}
</Overprint>
