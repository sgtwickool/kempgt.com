---
// The homepage poster: a climbing topo map, tokamak flux surfaces, a charged
// particle gyrating along a field line and a gradient-descent path, printed
// in three inks, with the headline overprinted on top.
import { heroPoster } from "../lib/art";

const art = heroPoster();
const headline =
  "m-0 font-sans text-[clamp(2.3rem,8.4vw,7rem)] leading-[0.9] font-black tracking-[-0.035em] [font-stretch:125%]";
---

<section class="relative h-[min(660px,82vw)] min-h-[340px] overflow-hidden" aria-labelledby="hero-title">
  <div
    aria-hidden="true"
    class="halftone ink absolute top-[6%] right-[7%] aspect-square w-[min(340px,46%)] rounded-full"
  >
  </div>
  <svg
    viewBox={`0 0 ${art.width} ${art.height}`}
    preserveAspectRatio="xMidYMid slice"
    class="absolute inset-0 h-full w-full"
    aria-hidden="true"
    focusable="false"
  >
    <g filter="url(#rough)">
      <path class="ink" d={art.topo} style="fill:none;stroke:var(--ink-strong);stroke-width:1.6;opacity:.85" />
      <path class="ink" d={art.rings} style="fill:none;stroke:var(--ink-line);stroke-width:2" />
      <path class="ink" d={art.wall} style="fill:none;stroke:var(--ink-line);stroke-width:5" />
      <path class="ink" d={art.gyro} style="fill:none;stroke:var(--ink);stroke-width:1.3;opacity:.6" />
      <path class="ink descent" d={art.descent} pathLength="1" />
      <circle class="ink minimum" cx={art.minimum[0]} cy={art.minimum[1]} r="10" />
    </g>
    <rect class="grain opacity-50" width={art.width} height={art.height} />
  </svg>

  <div class="absolute inset-x-0 bottom-[6%] mx-auto max-w-6xl px-5 sm:px-8">
    <div class="relative">
      <p aria-hidden="true" class:list={[headline, "ink absolute inset-0 translate-x-[5px] translate-y-[4px] text-ink-line dark:mix-blend-normal"]}>
        From fusion<br />to full stack.
      </p>
      <h1 id="hero-title" class:list={[headline, "ink relative text-ink-strong dark:mix-blend-normal"]}>
        From fusion<br />to full stack.
      </h1>
    </div>
  </div>
</section>

<style>
  .halftone {
    background-image: radial-gradient(circle, var(--ink-glow) 46%, transparent 48%);
    background-size: 10px 10px;
  }

  .descent {
    fill: none;
    stroke: var(--ink-strong);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .minimum {
    fill: var(--ink-strong);
  }

  /* The page's one piece of unprompted motion: the descent path draws itself
     in, then the minimum lands. */
  @media (prefers-reduced-motion: no-preference) {
    .descent {
      stroke-dashoffset: 1;
      animation: descend 2.6s cubic-bezier(0.45, 0.05, 0.25, 1) 0.3s forwards;
    }
    .minimum {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: arrive 0.45s ease-out 2.8s forwards;
    }
  }

  @keyframes descend {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
