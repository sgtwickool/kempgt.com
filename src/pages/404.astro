---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Print from "../components/Print.astro";
---

<BaseLayout title="Page not found | Greg Kemp">
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pt-10 sm:px-8 md:grid-cols-12 md:pt-20">
    <div class="flex flex-col gap-5 md:col-span-6">
      <SectionHeading text="Page not found" />
      <p class="m-0 text-[1.1rem] text-ink-soft">Nothing lives at this address. It may have moved when the site did.</p>
      <a href="/" class="button self-start">
        Go to the homepage
      </a>
    </div>
    <div class="md:col-span-5 md:col-start-8">
      <Print name="loss" />
    </div>
  </section>
</BaseLayout>
